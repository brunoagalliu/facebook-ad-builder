// Hand-written from the documented Python/SQLAlchemy model inventory (backend/app/models.py).
// This is a fresh Postgres (no production data to preserve/reconcile against), so models
// marked "best-effort" below are just that project's best-effort reconstruction of a few
// secondary tables that weren't read verbatim during exploration — adjust freely as this
// rewrite's own routes/services define what they actually need.
//
// Auth (User/Role/Permission/RefreshToken) uses Prisma's implicit many-to-many relations for
// user_roles/role_permissions rather than explicit join models — simpler code, at the cost of
// dropping the original schema's per-assignment `created_at` column (not load-bearing).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth / RBAC ----------

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  name           String?
  isActive       Boolean  @default(true) @map("is_active")
  isSuperuser    Boolean  @default(false) @map("is_superuser")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  roles         Role[]         @relation("UserRoles")
  refreshTokens RefreshToken[]

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  users       User[]       @relation("UserRoles")
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles Role[] @relation("RolePermissions")

  @@map("permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ---------- Brand / Product / Audience ----------

model Brand {
  id             String   @id @default(uuid())
  name           String
  logo           String?
  primaryColor   String   @default("#3B82F6") @map("primary_color")
  secondaryColor String   @default("#10B981") @map("secondary_color")
  highlightColor String   @default("#F59E0B") @map("highlight_color")
  voice          String?
  // Optional, user-assigned — lets generation auto-pick the best-fitting WinningAd
  // blueprint for this brand's niche (blueprintSelectionService.ts) instead of
  // requiring manual template browsing every time. Deliberately manual rather than
  // LLM-classified from voice/product text: predictable and free, at the cost of the
  // user having to set it once per brand.
  verticalId     String?  @map("vertical_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  products     Product[]
  profiles     CustomerProfile[] @relation("BrandProfiles")
  generatedAds GeneratedAd[]
  vertical     Vertical?         @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@map("brands")
}

model Product {
  id           String   @id @default(uuid())
  brandId      String   @map("brand_id")
  name         String
  description  String?
  productShots Json?    @map("product_shots")
  defaultUrl   String?  @map("default_url")
  createdAt    DateTime @default(now()) @map("created_at")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("products")
}

model CustomerProfile {
  id           String   @id @default(uuid())
  name         String
  demographics String?
  painPoints   String?  @map("pain_points")
  goals        String?
  createdAt    DateTime @default(now()) @map("created_at")

  brands Brand[] @relation("BrandProfiles")

  @@map("customer_profiles")
}

// ---------- Facebook campaign management (locally-persisted mirror) ----------

model FacebookCampaign {
  id           String   @id @default(uuid())
  name         String
  objective    String?
  budgetType   String?  @map("budget_type")
  dailyBudget  Int?     @map("daily_budget")
  bidStrategy  String?  @map("bid_strategy")
  status       String   @default("PAUSED")
  fbCampaignId String?  @map("fb_campaign_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  adSets FacebookAdSet[]

  @@map("facebook_campaigns")
}

model FacebookAdSet {
  id               String   @id @default(uuid())
  campaignId       String   @map("campaign_id")
  name             String
  optimizationGoal String?  @map("optimization_goal")
  dailyBudget      Int?     @map("daily_budget")
  bidStrategy      String?  @map("bid_strategy")
  bidAmount        Int?     @map("bid_amount")
  targeting        Json?
  pixelId          String?  @map("pixel_id")
  conversionEvent  String?  @map("conversion_event")
  status           String   @default("PAUSED")
  fbAdsetId        String?  @map("fb_adset_id")
  createdAt        DateTime @default(now()) @map("created_at")

  campaign FacebookCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      FacebookAd[]

  @@map("facebook_adsets")
}

model FacebookAd {
  id           String   @id @default(uuid())
  adsetId      String   @map("adset_id")
  name         String
  creativeName String?  @map("creative_name")
  imageUrl     String?  @map("image_url")
  mediaType    String   @default("image") @map("media_type")
  videoUrl     String?  @map("video_url")
  videoId      String?  @map("video_id")
  thumbnailUrl String?  @map("thumbnail_url")
  bodies       Json?
  headlines    Json?
  description  String?
  cta          String?
  websiteUrl   String?  @map("website_url")
  status       String   @default("ACTIVE")
  fbAdId       String?  @map("fb_ad_id")
  fbCreativeId String?  @map("fb_creative_id")
  createdAt    DateTime @default(now()) @map("created_at")

  adSet FacebookAdSet @relation(fields: [adsetId], references: [id], onDelete: Cascade)

  @@map("facebook_ads")
}

// ---------- Templates / Ad Remix / Generated ads ----------

model WinningAd {
  id                    String    @id @default(uuid())
  name                  String
  imageUrl              String    @map("image_url")
  notes                 String?
  tags                  String?
  // The scraped ad's raw copy elements, carried over as-is at promotion time
  // (winnerPromotionService.ts) — distinct from blueprintJson/videoBlueprintJson's
  // AI-derived structural analysis, which never preserved the actual original text a
  // user would want to reference/reuse (exact headline, exact body copy, exact CTA).
  headline              String?
  bodyText              String?   @map("body_text")
  ctaText               String?   @map("cta_text")
  analysis              String?
  recreationPrompt      String?   @map("recreation_prompt")
  topic                 String?
  mood                  String?
  subjectMatter         String?   @map("subject_matter")
  copyAnalysis          String?   @map("copy_analysis")
  productName           String?   @map("product_name")
  category              String?
  designStyle           String?   @map("design_style")
  filename              String?
  structuralAnalysis    String?   @map("structural_analysis")
  layering              String?
  templateStructure     Json?     @map("template_structure")
  colorPalette          Json?     @map("color_palette")
  typographySystem      Json?     @map("typography_system")
  copyPatterns          Json?     @map("copy_patterns")
  visualElements        Json?     @map("visual_elements")
  templateCategory      String?   @map("template_category")
  blueprintJson         Json?     @map("blueprint_json")
  blueprintAnalyzedAt   DateTime? @map("blueprint_analyzed_at")
  // Set only for auto-promoted blueprints (winnerPromotionService.ts) — null for
  // manually uploaded templates. verticalId lets "top winners per vertical" queries
  // work; sourceScrapedAdId is unique so the same scraped ad is never promoted twice.
  verticalId            String?   @map("vertical_id")
  sourceScrapedAdId     String?   @unique @map("source_scraped_ad_id")
  // The source ad's run_duration_days at promotion time (see researchService.ts's
  // computeRunDurationDays) — lets blueprintSelectionService.ts rank auto-promoted
  // blueprints by strength instead of picking arbitrarily among a vertical's pool.
  sourceRunDurationDays Int?      @map("source_run_duration_days")
  // Stage 4: video-native blueprints (videoBlueprintService.ts, Gemini video
  // understanding) — separate shape from blueprintJson's image-composition fields
  // (hook/pacing/cinematography/dialogue instead of layout/visual-style), since a
  // video ad's structure isn't describable in image-blueprint terms. mediaType
  // records which kind of source this blueprint came from; imageUrl stays required
  // (a thumbnail/placeholder for video rows) so every existing image_url consumer in
  // the frontend keeps working unchanged.
  mediaType             String    @default("image") @map("media_type")
  videoUrl              String?   @map("video_url")
  videoBlueprintJson    Json?     @map("video_blueprint_json")
  createdAt             DateTime  @default(now()) @map("created_at")

  generatedAds    GeneratedAd[]
  vertical        Vertical?     @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  sourceScrapedAd ScrapedAd?    @relation(fields: [sourceScrapedAdId], references: [id], onDelete: SetNull)

  @@map("winning_ads")
}

model GeneratedAd {
  id           String   @id @default(uuid())
  brandId      String?  @map("brand_id")
  productId    String?  @map("product_id")
  templateId   String?  @map("template_id")
  imageUrl     String?  @map("image_url")
  headline     String?
  body         String?
  cta          String?
  sizeName     String?  @map("size_name")
  dimensions   String?
  prompt       String?
  adBundleId   String?  @map("ad_bundle_id")
  mediaType    String   @default("image") @map("media_type")
  videoUrl     String?  @map("video_url")
  videoId      String?  @map("video_id")
  thumbnailUrl String?  @map("thumbnail_url")
  createdAt    DateTime @default(now()) @map("created_at")

  brand    Brand?     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  template WinningAd? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@map("generated_ads")
}

// ---------- Research / competitor scraping ----------
// Verbatim from backend/app/models.py (confirmed against source directly, not best-effort).

model Vertical {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  savedSearches SavedSearch[]
  searchLogs    SearchLog[]
  facebookPages FacebookPage[]
  winningAds    WinningAd[]
  brands        Brand[]

  @@map("verticals")
}

model FacebookPage {
  id         String   @id @default(uuid())
  pageName   String   @unique @map("page_name")
  pageUrl    String?  @map("page_url")
  verticalId String?  @map("vertical_id")
  totalAds   Int      @default(0) @map("total_ads")
  firstSeen  DateTime @default(now()) @map("first_seen")
  lastSeen   DateTime @default(now()) @updatedAt @map("last_seen")
  createdAt  DateTime @default(now()) @map("created_at")

  vertical Vertical?   @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  ads      ScrapedAd[]

  @@map("facebook_pages")
}

model SavedSearch {
  id               String    @id @default(uuid())
  query            String
  country          String?
  negativeKeywords Json?     @map("negative_keywords")
  verticalId       String?   @map("vertical_id")
  searchType       String    @default("one_time") @map("search_type")
  scheduleConfig   Json?     @map("schedule_config")
  isActive         Boolean   @default(true) @map("is_active")
  lastRun          DateTime? @map("last_run")
  adsRequested     Int?      @map("ads_requested")
  adsReturned      Int?      @map("ads_returned")
  adsNew           Int?      @map("ads_new")
  adsDuplicate     Int?      @map("ads_duplicate")
  createdAt        DateTime  @default(now()) @map("created_at")

  vertical Vertical?   @relation(fields: [verticalId], references: [id], onDelete: SetNull)
  ads      ScrapedAd[]

  @@map("saved_searches")
}

model ApiUsageLog {
  id          String   @id @default(uuid())
  endpoint    String
  apiCalls    Int      @map("api_calls")
  adsReturned Int      @map("ads_returned")
  adsSaved    Int      @map("ads_saved")
  query       String?
  createdAt   DateTime @default(now()) @map("created_at")
  date        String

  @@map("api_usage_logs")
}

model PageBlacklist {
  id        String   @id @default(uuid())
  pageName  String   @unique @map("page_name")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("page_blacklist")
}

model KeywordBlacklist {
  id        String   @id @default(uuid())
  keyword   String   @unique
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("keyword_blacklist")
}

model SearchLog {
  id                         String   @id @default(uuid())
  searchQuery                String   @map("search_query")
  country                    String?
  negativeKeywords           Json?    @map("negative_keywords")
  verticalId                 String?  @map("vertical_id")
  totalAdsFound              Int      @default(0) @map("total_ads_found")
  filteredByPageBlacklist    Int      @default(0) @map("filtered_by_page_blacklist")
  filteredByKeywordBlacklist Int      @default(0) @map("filtered_by_keyword_blacklist")
  finalAdsSaved              Int      @default(0) @map("final_ads_saved")
  newPagesBlacklisted        Json?    @map("new_pages_blacklisted")
  apiCallsMade               Int      @default(0) @map("api_calls_made")
  searchType                 String?  @map("search_type")
  executionTimeSeconds       Int?     @map("execution_time_seconds")
  createdAt                  DateTime @default(now()) @map("created_at")
  date                       String

  vertical Vertical? @relation(fields: [verticalId], references: [id], onDelete: SetNull)

  @@map("search_logs")
}

model ScrapedAd {
  id               String   @id @default(uuid())
  brandName        String?  @map("brand_name")
  headline         String?
  adCopy           String?  @map("ad_copy")
  ctaText          String?  @map("cta_text")
  platform         String   @default("facebook")
  externalId       String?  @unique @map("external_id")
  contentHash      String?  @unique @map("content_hash")
  adLink           String   @map("ad_link")
  platforms        Json?
  startDate        String?  @map("start_date")
  // Facebook's ad-snapshot page URL — an HTML page, not a direct image, but usable
  // with extractMediaFromSnapshot (winnerPromotionService.ts) to fetch a real image
  // for blueprint deconstruction. Requested from the Graph API but discarded before
  // this, same bug pattern as impressions/spend below.
  adSnapshotUrl    String?  @map("ad_snapshot_url")
  // Meta's ad_delivery_stop_time — present only once an ad has actually stopped
  // running; null means "still active" as of the last time we saw it. Together with
  // startDate this is the run-duration "winner" signal: Meta only populates
  // impressions/spend (below) for political/issue ads, so for ordinary commercial ads
  // how long an ad has kept running is the best proxy this API exposes for "this is
  // working" — nobody pays to keep a losing ad live for weeks.
  stopDate         String?  @map("stop_date")
  // Meta returns these as {lower_bound, upper_bound} ranges, not single numbers, and
  // only for political/issue ads — null for the vast majority of commercial ads this
  // app scrapes. Captured when present rather than silently discarded (as it was
  // before), not the primary winner signal.
  impressionsLower Int?     @map("impressions_lower")
  impressionsUpper Int?     @map("impressions_upper")
  spendLower       Int?     @map("spend_lower")
  spendUpper       Int?     @map("spend_upper")
  currency         String?
  mediaType        String?  @map("media_type")
  firstSeen        DateTime @default(now()) @map("first_seen")
  lastSeen         DateTime @default(now()) @updatedAt @map("last_seen")
  seenCount        Int      @default(1) @map("seen_count")
  searchId         String?  @map("search_id")
  facebookPageId   String?  @map("facebook_page_id")
  createdAt        DateTime @default(now()) @map("created_at")

  savedSearch  SavedSearch?  @relation(fields: [searchId], references: [id], onDelete: Cascade)
  facebookPage FacebookPage? @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)
  winningAd    WinningAd?

  @@map("scraped_ads")
}

model BrandScrape {
  id              String   @id @default(uuid())
  brandName       String   @map("brand_name")
  pageId          String   @map("page_id")
  pageName        String?  @map("page_name")
  pageUrl         String   @map("page_url")
  totalAds        Int      @default(0) @map("total_ads")
  mediaDownloaded Int      @default(0) @map("media_downloaded")
  status          String   @default("pending")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  ads BrandScrapedAd[]

  @@map("brand_scrapes")
}

model BrandScrapedAd {
  id                String   @id @default(uuid())
  brandScrapeId     String   @map("brand_scrape_id")
  externalId        String   @map("external_id")
  pageName          String?  @map("page_name")
  pageLink          String?  @map("page_link")
  headline          String?
  adCopy            String?  @map("ad_copy")
  ctaText           String?  @map("cta_text")
  mediaType         String?  @map("media_type")
  mediaUrls         Json?    @map("media_urls")
  originalMediaUrls Json?    @map("original_media_urls")
  platforms         Json?
  startDate         String?  @map("start_date")
  adLink            String?  @map("ad_link")
  createdAt         DateTime @default(now()) @map("created_at")

  brandScrape BrandScrape @relation(fields: [brandScrapeId], references: [id], onDelete: Cascade)

  @@map("brand_scraped_ads")
}

// ---------- Reusable prompt / style libraries ----------

model Prompt {
  id          String  @id
  name        String
  category    String
  template    String
  description String?
  variables   Json?
  notes       String?

  @@map("prompts")
}

model AdStyle {
  id           String  @id
  name         String
  category     String
  description  String?
  bestFor      Json?   @map("best_for")
  visualLayout String? @map("visual_layout")
  psychology   String?
  mood         String?
  lighting     String?
  composition  String?
  designStyle  String? @map("design_style")
  prompt       String?

  @@map("ad_styles")
}
